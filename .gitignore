# Ignore bundler config
/.bundle

# Ignore all logfiles and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore bootsnap cache
tmp/cache/bootsnap/

# Ignore uploaded files in development
/storage/*
!/storage/.keep
/public/uploads

# Ignore master key for decrypting credentials and more
/config/master.key
/config/credentials/*.key

# Ignore environment files
.env
.env.local
.env.*.local

# Ignore IDE/Editor specific files
.idea/
.vscode/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore node_modules if using JavaScript
/node_modules

# Ignore pid files
/tmp/pids/*

# Ignore coverage reports
/coverage

# Ignore gem documentation
/doc/
/.yardoc

# Ignore byebug history
.byebug_history

# Ignore precompiled assets
/public/assets

# Ignore Ansible plugins (mitogen — installed locally, not committed)
/ansible/plugins/

# Ignore generated Ansible inventory files
/ansible/inventory/*.ini

# Ignore monitoring data volumes
/monitoring/prometheus/data/
/monitoring/grafana/data/
extract_pdf.rb
/monitoring/prometheus/targets/*.json

# AI Blueprint local workflow files
.agents/
.claude/
blueprint/
CLAUDE.md
