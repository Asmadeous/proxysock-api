<p>Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p>Your proxy credentials for order <strong>#<%= @order.order_number %></strong> are now ready.</p>

<div style="background-color: #f9fafb; padding: 20px; border-radius: 8px; margin: 20px 0;">
  <h3 style="margin-top: 0;">Proxy Details</h3>
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 14px;">
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">IP Address:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= @proxy.ip_address %></td>
    </tr>
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">Port:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= @proxy.port %></td>
    </tr>
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">Username:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= @proxy.username %></td>
    </tr>
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">Password:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= @proxy.password %></td>
    </tr>
    <% if @proxy.respond_to?(:country_code) && @proxy.country_code.present? %>
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">Location:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= @proxy.country_code %></td>
    </tr>
    <% end %>
  </table>
</div>

<p>You can also view these details in your dashboard: <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/orders" style="color: #3b82f6; text-decoration: none;">View Orders</a></p>

<p>Best Regards,<br>The ProxySock Team</p>
