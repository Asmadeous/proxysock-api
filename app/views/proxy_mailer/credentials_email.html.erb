<div style="font-family: sans-serif; line-height: 1.6;">
  <h2>Your Proxy is Ready!</h2>
  
  <p>Hello <%= @owner.respond_to?(:first_name) ? @owner.first_name : @owner.company_name %>,</p>
  
  <p>Your proxy access for Order #<%= @order.id %> has been provisioned. Here are your credentials:</p>
  
  <table border="1" cellpadding="10" cellspacing="0" style="border-collapse: collapse; margin: 20px 0;">
    <tr>
      <th style="background: #f5f5f5;">IP Address</th>
      <td><%= @proxy.ip_address %></td>
    </tr>
    <tr>
      <th style="background: #f5f5f5;">Port</th>
      <td><%= @proxy.port %></td>
    </tr>
    <tr>
      <th style="background: #f5f5f5;">Username</th>
      <td><code><%= @proxy.username %></code></td>
    </tr>
    <tr>
      <th style="background: #f5f5f5;">Password</th>
      <td><code><%= @proxy.password %></code></td>
    </tr>
  </table>
  
  <h3>Connection String</h3>
  <pre style="background: #f5f5f5; padding: 10px; border-radius: 5px;"><%= @proxy.ip_address %>:<%= @proxy.port %>:<%= @proxy.username %>:<%= @proxy.password %></pre>
  
  <p>Thank you for choosing ProxySock!</p>
</div>
