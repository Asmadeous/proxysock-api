<h1 style="font-size: 24px; margin-bottom: 24px; color: #000000;">Proxy Credentials Ready</h1>

<p style="margin-bottom: 24px;">Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p style="margin-bottom: 32px;">Your proxy credentials for order <strong>#<%= @order.order_number %></strong> are now ready for use.</p>

<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 12px; padding: 32px; margin-bottom: 32px;">
    <h3 style="margin-bottom: 20px; font-size: 18px;">Access Details</h3>
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
        <tr>
            <td style="padding: 8px 0;">IP Address</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @proxy.ip_address %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Port</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @proxy.port %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Username</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @proxy.username %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Password</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @proxy.password %></td>
        </tr>
        <% if @proxy.respond_to?(:country_code) && @proxy.country_code.present? %>
        <tr>
            <td style="padding: 8px 0;">Location</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @proxy.country_code %></td>
        </tr>
        <% end %>
    </table>
</div>

<div style="text-align: center; margin: 40px 0;">
    <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/orders" class="btn">Manage Orders</a>
</div>
