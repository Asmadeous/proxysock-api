<h2 style="margin-top: 0; color: #EF4444; font-family: 'Outfit', sans-serif;">
  ⚠️ <%= @context %> — Ticket #<%= @ticket.id %>
</h2>

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden;">
  <tr style="background-color: #f9fafb;">
    <td style="padding: 12px 16px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb; width: 140px;">Customer</td>
    <td style="padding: 12px 16px; color: #1f2937; border-bottom: 1px solid #e5e7eb;">
      <%= @user.try(:email) || @user.try(:username) || 'Unknown' %>
    </td>
  </tr>
  <tr>
    <td style="padding: 12px 16px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Subject</td>
    <td style="padding: 12px 16px; color: #1f2937; border-bottom: 1px solid #e5e7eb;">
      <%= @ticket.subject %>
    </td>
  </tr>
  <% if @ticket.order.present? %>
  <tr style="background-color: #f9fafb;">
    <td style="padding: 12px 16px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Order</td>
    <td style="padding: 12px 16px; color: #1f2937; border-bottom: 1px solid #e5e7eb;">
      #<%= @ticket.order.order_number %>
    </td>
  </tr>
  <% end %>
  <% if @ticket.deposit.present? %>
  <tr style="background-color: #f9fafb;">
    <td style="padding: 12px 16px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Deposit</td>
    <td style="padding: 12px 16px; color: #1f2937; border-bottom: 1px solid #e5e7eb;">
      #<%= @ticket.deposit.id %> (<%= @ticket.deposit.gateway %>)
    </td>
  </tr>
  <% end %>
  <tr>
    <td style="padding: 12px 16px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Priority</td>
    <td style="padding: 12px 16px; border-bottom: 1px solid #e5e7eb;">
      <span style="display: inline-block; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 600; background-color: rgba(239, 68, 68, 0.15); color: #EF4444; text-transform: uppercase;">
        <%= @ticket.priority %>
      </span>
    </td>
  </tr>
  <tr style="background-color: #f9fafb;">
    <td style="padding: 12px 16px; font-weight: 600; color: #374151;">Error</td>
    <td style="padding: 12px 16px; color: #991b1b; font-family: monospace; font-size: 13px;">
      <%= @error_message %>
    </td>
  </tr>
</table>

<p style="color: #6b7280; font-size: 14px; line-height: 1.6;">
  This ticket was automatically generated by ProxySock when a <%= @context.downcase %> was detected.
  The customer has been notified and a local ticket has been created in the system.
</p>

<p style="color: #6b7280; font-size: 13px; margin-top: 24px;">
  <strong>Ticket created at:</strong> <%= @ticket.created_at.strftime('%Y-%m-%d %H:%M:%S %Z') %>
</p>
