<h1 style="font-size: 24px; margin-bottom: 24px; color: #000000;">VM Credentials Ready</h1>

<p style="margin-bottom: 24px;">Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p style="margin-bottom: 32px;">Your virtual machine for order <strong>#<%= @order.order_number %></strong> is now ready and active.</p>

<%= render partial: 'mailers/jellyfin_section' %>

<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 12px; padding: 32px; margin-bottom: 32px;">
    <h3 style="margin-bottom: 20px; font-size: 18px;">Access Credentials</h3>
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
        <tr>
            <td style="padding: 8px 0;">Host Address</td>
            <td style="padding: 8px 0; text-align: right; color: #4F46E5; font-weight: 600;">
                <% connection_string = @vm.connection_host %>
                <%= @is_rdp ? "#{connection_string}:#{@vm.rdp_port || 3389}" : connection_string %>
            </td>
        </tr>
        <% if @vm.ssh_port.present? %>
        <tr>
            <td style="padding: 8px 0;">SSH Port</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @vm.ssh_port %></td>
        </tr>
        <% end %>
        <tr>
            <td style="padding: 8px 0;">Username</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @vm.ssh_username || @vm.rdp_username || (@vm.vm_type == 'rdp' ? 'Administrator' : 'root') %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Password</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @vm.root_password || @vm.ssh_password || @vm.ssh_password_encrypted || @vm.rdp_password_encrypted %></td>
        </tr>
    </table>
</div>

<div style="background-color: #E7F3FF; padding: 20px; border-radius: 8px; margin-bottom: 32px; border: 1px solid #BEE3F8;">
    <h4 style="margin: 0 0 12px 0; color: #2B6CB0; font-size: 16px;">Quick Connect:</h4>
    <div style="background: #ffffff; padding: 12px; border-radius: 6px; border: 1px solid #CBD5E1; font-family: monospace; color: #1E293B; margin-bottom: 12px;">
        <% if @vm.rdp_port.present? || @vm.vm_type == 'rdp' %>
            <strong>RDP Target:</strong> <%= @vm.connection_host %>:<%= @vm.rdp_port || 3389 %><br>
        <% end %>
        <% if @vm.ssh_port.present? || @vm.vm_type != 'rdp' %>
            <strong>SSH Command:</strong> ssh <%= @vm.ssh_username || 'root' %>@<%= @vm.connection_host %> -p <%= @vm.ssh_port || 22 %><br>
        <% end %>
        <strong>Password:</strong> <%= @vm.root_password || @vm.ssh_password || @vm.ssh_password_encrypted || @vm.rdp_password_encrypted %>
    </div>
    <ul style="margin: 0; padding-left: 20px; color: #2D3748; font-size: 14px; line-height: 1.6;">
        <% if @vm.rdp_port.present? || @vm.vm_type == 'rdp' %>
        <li><strong>Windows (RDP):</strong> Open "Remote Desktop Connection", paste the RDP Target above, and enter your credentials.</li>
        <% end %>
        <% if @vm.ssh_port.present? || @vm.vm_type != 'rdp' %>
        <li><strong>Linux (SSH):</strong> Open your terminal, paste the SSH Command above, and enter the password when prompted.</li>
        <% end %>
    </ul>
</div>

<% if @is_rdp %>
<div style="background-color: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 12px; padding: 24px; margin-bottom: 32px;">
    <h4 style="margin: 0 0 12px 0; color: #166534; font-size: 16px;">One-Click Connect File Attached</h4>
    <p style="margin: 0 0 16px 0; color: #14532D; font-size: 14px; line-height: 1.6;">
        We've attached a ready-to-use <strong><%= @rdp_filename %></strong> file to this email. It already
        contains your server address, port, and username — just open it and enter your password.
    </p>
    <ol style="margin: 0; padding-left: 20px; color: #14532D; font-size: 14px; line-height: 1.8;">
        <li><strong>Windows:</strong> Download the attached <strong>.rdp</strong> file and double-click it. Click <em>Connect</em>, then enter the password shown above when prompted.</li>
        <li><strong>macOS:</strong> Install <strong>Windows App</strong> (or Microsoft Remote Desktop) from the App Store, then open the attached <strong>.rdp</strong> file with it.</li>
        <li><strong>Android / iOS:</strong> Install <strong>Microsoft Remote Desktop</strong> (Windows App), then import the attached <strong>.rdp</strong> file.</li>
    </ol>
    <p style="margin: 16px 0 0 0; color: #166534; font-size: 13px; line-height: 1.6;">
        For your security the password is <strong>not</strong> stored in the file — always enter it manually using the credentials above.
    </p>
</div>
<% end %>

<% if @vm.vm_type.to_s.include?('managed') || (@vm.vm_order&.vm_type.to_s.include?('managed')) %>
<div style="background-color: #EEF2FF; border: 1px solid #C7D2FE; border-radius: 12px; padding: 32px; margin-bottom: 32px;">
    <h3 style="margin-bottom: 20px; font-size: 18px; color: #3730A3;">Managed Monitoring Dashboard</h3>
    <p style="margin-bottom: 20px; font-size: 14px;">You can monitor your VM performance and stats in real-time using our shared dashboard.</p>
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
        <tr>
            <td style="padding: 8px 0;">Dashboard Link</td>
            <td style="padding: 8px 0; text-align: right;"><a href="<%= ENV['FRONTEND_URL'] %>/monitoring/login" style="color: #4F46E5; font-weight: 600; text-decoration: none;">Access Monitoring</a></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Login Username</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @vm.proxmox_vm_id %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Login Password</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;">(Same as VM Password)</td>
        </tr>
    </table>
</div>
<% end %>

<div style="background-color: #FFFBEB; border: 1px solid #FEF3C7; border-radius: 12px; padding: 20px; margin-bottom: 32px;">
    <p style="margin: 0; color: #92400E; font-size: 14px; line-height: 1.6;">
        <strong>Important Notice:</strong> Once your VM reaches its expiration date, all access will be temporarily disabled. We will stop the instance to preserve your data and IP address, but you will need to renew your subscription to regain access.
    </p>
</div>

<div style="text-align: center; margin: 40px 0;">
    <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/orders" class="btn">Manage Instance</a>
</div>
