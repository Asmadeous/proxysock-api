<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <h1>Your VM is Ready</h1>
    <p>Order ID: <%= @order.id %></p>
    
    <div style="background: #f0f0f0; padding: 15px; border-radius: 5px;">
      <h3>Access Details</h3>
      <p><strong>IP Address:</strong> <%= @vm.ip_address %></p>
      <p><strong>User:</strong> <%= @vm.ssh_username %></p>
      <!-- We typically don't email passwords if key-based, but for this requirement: -->
      <% if @vm.ssh_password_encrypted %>
        <p><strong>Password:</strong> (As provided/generated)</p>
      <% end %>
    </div>
    
    <p>You can manage your VM status from the dashboard.</p>
  </body>
</html>
