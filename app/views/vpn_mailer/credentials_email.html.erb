<h1 style="font-size: 24px; margin-bottom: 24px; color: #000000;">VPN Credentials</h1>

<p style="margin-bottom: 24px;">Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p style="margin-bottom: 32px;">Your VPN credentials for order <strong>#<%= @order.order_number %></strong> are now ready for use.</p>

<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 12px; padding: 32px; margin-bottom: 32px;">
    <h3 style="margin-bottom: 20px; font-size: 18px;">Access Details</h3>
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
        <tr>
            <td style="padding: 8px 0;">Server IP</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @vpn_account.server_ip %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Username</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @vpn_account.username %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Password</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @vpn_account.password %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Protocol</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;">WireGuard (Shared)</td>
        </tr>
    </table>
</div>

<div style="text-align: center; margin: 40px 0;">
    <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/orders" class="btn">Manage VPN</a>
</div>
