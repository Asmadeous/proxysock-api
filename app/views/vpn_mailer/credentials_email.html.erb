<div style="font-family: sans-serif; line-height: 1.6;">
  <h2>Your VPN is Ready!</h2>
  
  <p>Hello <%= @owner.respond_to?(:first_name) ? @owner.first_name : @owner.company_name %>,</p>
  
  <p>Your VPN access has been provisioned. Here are your credentials:</p>
  
  <table border="1" cellpadding="10" cellspacing="0" style="border-collapse: collapse; margin: 20px 0;">
    <tr>
      <th style="background: #f5f5f5;">Server</th>
      <td><%= @vpn.server %></td>
    </tr>
    <tr>
      <th style="background: #f5f5f5;">Protocol</th>
      <td><%= @vpn.protocol.upcase %></td>
    </tr>
    <tr>
      <th style="background: #f5f5f5;">Username</th>
      <td><code><%= @vpn.username %></code></td>
    </tr>
    <tr>
      <th style="background: #f5f5f5;">Password</th>
      <td><code><%= @vpn.password %></code></td>
    </tr>
  </table>
  
  <h3>Setup Instructions</h3>
  <ol>
    <li>Download a VPN client supporting <%= @vpn.protocol.upcase %></li>
    <li>Import the configuration or enter the server address</li>
    <li>Use the credentials above to authenticate</li>
  </ol>
  
  <p>Thank you for choosing ProxySock!</p>
</div>
