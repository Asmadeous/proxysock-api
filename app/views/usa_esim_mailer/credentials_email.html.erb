<p>Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p>Your USA eSIM credentials for order <strong>#<%= @order.order_number %></strong> are now ready.</p>

<div style="background-color: #f9fafb; padding: 20px; border-radius: 8px; margin: 20px 0;">
  <h3 style="margin-top: 0;">eSIM Credentials</h3>
  <% @credentials.each_with_index do |cred, index| %>
    <div style="margin-bottom: 20px; <%= 'border-top: 1px solid #e5e7eb; padding-top: 15px;' if index > 0 %>">
      <p><strong>Line <%= index + 1 %>:</strong></p>
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 14px;">
        <tr>
          <td style="padding: 5px 0; color: #6b7280;">Provider:</td>
          <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= cred.provider %></td>
        </tr>
        <tr>
          <td style="padding: 5px 0; color: #6b7280;">Phone Number:</td>
          <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= cred.phone_number %></td>
        </tr>
        <% if cred.sm_dp_address.present? %>
        <tr>
          <td style="padding: 5px 0; color: #6b7280;">SM-DP+ Address:</td>
          <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= cred.sm_dp_address %></td>
        </tr>
        <% end %>
        <% if cred.activation_code.present? %>
        <tr>
          <td style="padding: 5px 0; color: #6b7280;">Activation Code:</td>
          <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= cred.activation_code %></td>
        </tr>
        <% end %>
      </table>
    </div>
  <% end %>
</div>

<p>You can also view these details in your dashboard: <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/orders" style="color: #3b82f6; text-decoration: none;">View Orders</a></p>

<p>Best Regards,<br>The ProxySock Team</p>
