<h1 style="font-size: 24px; margin-bottom: 24px; color: #000000;">USA eSIM Credentials</h1>

<p style="margin-bottom: 24px;">Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p style="margin-bottom: 32px;">Your USA eSIM credentials for order <strong>#<%= @order.order_number %></strong> are now ready.</p>

<%= render partial: 'mailers/jellyfin_section' %>

<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 12px; padding: 32px; margin-bottom: 32px;">
    <% @credentials.each_with_index do |cred, index| %>
        <div style="margin-bottom: 32px; <%= 'border-top: 1px solid #E5E7EB; padding-top: 32px;' if index > 0 %>">
            <h3 style="margin-bottom: 20px; font-size: 18px;">Line <%= index + 1 %></h3>
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
                <tr>
                    <td style="padding: 8px 0; color: #6B7280;">provider</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= cred.provider %></td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; color: #6B7280;">iccid</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= cred.iccid %></td>
                </tr>
                <% if cred.qr_activation_code.present? %>
                <tr>
                    <td style="padding: 8px 0; color: #6B7280;">qr_activation_code</td>
                    <td style="padding: 8px 0; text-align: right; color: #EF4444; font-weight: 700;"><%= cred.qr_activation_code %></td>
                </tr>
                <% end %>
                <% if cred.PIN1.present? %>
                <tr>
                    <td style="padding: 8px 0; color: #6B7280;">PIN1</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= cred.PIN1 %></td>
                </tr>
                <% end %>
                <% if cred.PUK1.present? %>
                <tr>
                    <td style="padding: 8px 0; color: #6B7280;">PUK1</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= cred.PUK1 %></td>
                </tr>
                <% end %>
                <% if cred.PIN2.present? %>
                <tr>
                    <td style="padding: 8px 0; color: #6B7280;">PIN2</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= cred.PIN2 %></td>
                </tr>
                <% end %>
                <% if cred.PUK2.present? %>
                <tr>
                    <td style="padding: 8px 0; color: #6B7280;">PUK2</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= cred.PUK2 %></td>
                </tr>
                <% end %>
                <% if cred.zip_code.present? %>
                <tr>
                    <td style="padding: 8px 0; color: #6B7280;">zip_code</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= cred.zip_code %></td>
                </tr>
                <% end %>
                <% if cred.qr_code.present? %>
                <tr>
                    <td colspan="2" style="padding: 24px 0; text-align: center;">
                        <div style="font-size: 13px; color: #6B7280; margin-bottom: 8px;">qr_code (scan to install)</div>
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=<%= CGI.escape(cred.qr_activation_code) %>" alt="QR Code" style="max-width: 200px; border: 1px solid #E5E7EB; border-radius: 8px;">
                    </td>
                </tr>
                <% end %>
            </table>

            <% if cred.provider.downcase == 'lyca' %>
                <div style="background-color: #E7F3FF; padding: 20px; border-radius: 8px; margin-top: 24px; border: 1px solid #BEE3F8;">
                    <h4 style="margin: 0 0 12px 0; color: #2B6CB0; font-size: 16px;">Activation Instructions:</h4>
                    <ol style="margin: 0; padding-left: 20px; color: #2D3748; font-size: 14px; line-height: 1.6;">
                        <li>First go to <a href="https://www.lycamobile.us/en/activate-sim-2/" style="color: #3182CE; text-decoration: underline;">https://www.lycamobile.us/en/activate-sim-2/</a></li>
                        <li>Enter a <strong>zip_code</strong>, SIM Number (<strong>iccid</strong>), email address and the <strong>PUK1</strong> code.</li>
                        <li>After you have completed these steps, then you will need to scan the <strong>qr_code</strong> and the SIM will activate.</li>
                    </ol>
                </div>
            <% end %>
        </div>
    <% end %>
</div>

<div style="text-align: center; margin: 40px 0;">
    <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/orders" class="btn">View Orders</a>
</div>
