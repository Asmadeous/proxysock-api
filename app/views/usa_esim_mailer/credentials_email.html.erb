<h1 style="font-size: 24px; margin-bottom: 24px; color: #000000;">USA eSIM Credentials</h1>

<p style="margin-bottom: 24px;">Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p style="margin-bottom: 32px;">Your USA eSIM credentials for order <strong>#<%= @order.order_number %></strong> are now ready.</p>

<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 12px; padding: 32px; margin-bottom: 32px;">
    <% @credentials.each_with_index do |cred, index| %>
        <div style="margin-bottom: 32px; <%= 'border-top: 1px solid #E5E7EB; padding-top: 32px;' if index > 0 %>">
            <h3 style="margin-bottom: 20px; font-size: 18px;">Line <%= index + 1 %></h3>
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
                <tr>
                    <td style="padding: 8px 0;">Provider</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= cred.provider %></td>
                </tr>
                <tr>
                    <td style="padding: 8px 0;">Phone Number</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= cred.phone_number %></td>
                </tr>
                <% if cred.sm_dp_address.present? %>
                <tr>
                    <td style="padding: 8px 0;">SM-DP+ Address</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= cred.sm_dp_address %></td>
                </tr>
                <% end %>
                <% if cred.activation_code.present? %>
                <tr>
                    <td style="padding: 8px 0;">Activation Code</td>
                    <td style="padding: 8px 0; text-align: right; color: #EF4444; font-weight: 700;"><%= cred.activation_code %></td>
                </tr>
                <% end %>
            </table>
        </div>
    <% end %>
</div>

<div style="text-align: center; margin: 40px 0;">
    <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/orders" class="btn">View Orders</a>
</div>
