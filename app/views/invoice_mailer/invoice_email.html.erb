<h1 style="font-size: 24px; margin-bottom: 24px; color: #000000;">Order Confirmation</h1>

<p style="margin-bottom: 24px;">Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p style="margin-bottom: 32px;">Thank you for your purchase! We've received your order and are currently provisioning your services.</p>

<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 12px; padding: 32px; margin-bottom: 32px;">
    <h3 style="margin-bottom: 20px; font-size: 18px;">Order Details</h3>
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
        <tr>
            <td style="padding: 8px 0;">Order Number</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;">#<%= @order.order_number %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Product</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @order.product.name %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Quantity</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @order.quantity %></td>
        </tr>
        <tr>
            <td style="padding: 20px 0 0 0; border-top: 1px solid #E5E7EB; font-size: 18px; color: #000000; font-weight: 700;">Total Paid</td>
            <td style="padding: 20px 0 0 0; border-top: 1px solid #E5E7EB; text-align: right; font-size: 18px; color: #EF4444; font-weight: 700;">
                <%= number_to_currency(@order.total_amount) %>
            </td>
        </tr>
    </table>
</div>

<p style="margin-bottom: 32px; color: #4B5563;">You will receive another email with your credentials once provisioning is complete.</p>

<div style="text-align: center; margin: 40px 0;">
    <a href="<%= ENV['FRONTEND_URL'] %>/dashboard" class="btn">Go to Dashboard</a>
</div>
