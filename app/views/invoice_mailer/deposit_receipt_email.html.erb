<h1 style="font-size: 24px; margin-bottom: 24px; color: #000000;">Deposit Confirmed</h1>

<p style="margin-bottom: 24px;">Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p style="margin-bottom: 32px;">Your deposit has been successfully confirmed. Your wallet balance has been updated and is ready for use.</p>

<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 12px; padding: 32px; margin-bottom: 32px;">
    <h3 style="margin-bottom: 20px; font-size: 18px;">Deposit Receipt</h3>
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
        <tr>
            <td style="padding: 8px 0;">Reference</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @deposit.metadata&.dig('transaction_ref') || @deposit.id %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Gateway</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600; text-transform: capitalize;"><%= @gateway %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Date</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @deposit.completed_at&.strftime('%B %d, %Y') %></td>
        </tr>
        <tr>
            <td style="padding: 20px 0 0 0; border-top: 1px solid #E5E7EB; font-size: 18px; color: #000000; font-weight: 700;">Amount Credited</td>
            <td style="padding: 20px 0 0 0; border-top: 1px solid #E5E7EB; text-align: right; font-size: 18px; color: #EF4444; font-weight: 700;">
                <%= number_to_currency(@amount) %>
            </td>
        </tr>
    </table>
</div>

<div style="text-align: center; margin: 40px 0;">
    <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/billing" class="btn">View Wallet Balance</a>
</div>
