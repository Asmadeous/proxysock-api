<p>Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p>Your <strong><%= @order.product.name %></strong> for order <strong>#<%= @order.order_number %></strong> is now active.</p>

<div style="background-color: #f9fafb; padding: 20px; border-radius: 8px; margin: 20px 0;">
  <h3 style="margin-top: 0;">Access Credentials</h3>
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 14px;">
    <% if @api_response['ip'].present? %>
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">IP Address:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right; font-family: monospace;"><%= @api_response['ip'] %></td>
    </tr>
    <% end %>
    <% port = @api_response['port'] || @api_response['http_port'] || @api_response['socks5_port'] %>
    <% if port.present? %>
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">Port:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right; font-family: monospace;"><%= port %></td>
    </tr>
    <% end %>
    <% if @api_response['username'].present? %>
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">Username:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right; font-family: monospace;"><%= @api_response['username'] %></td>
    </tr>
    <% end %>
    <% if @api_response['password'].present? %>
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">Password:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right; font-family: monospace;"><%= @api_response['password'] %></td>
    </tr>
    <% end %>
    <% if @api_response['country'].present? || @api_response['location'].present? %>
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">Location:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= @api_response['country'] || @api_response['location'] %></td>
    </tr>
    <% end %>
    <% if @api_response['expires_at'].present? || @api_response['expiry'].present? %>
    <tr>
      <td style="padding: 5px 0; color: #6b7280;">Expires:</td>
      <td style="padding: 5px 0; font-weight: bold; text-align: right;"><%= @api_response['expires_at'] || @api_response['expiry'] %></td>
    </tr>
    <% end %>
  </table>
</div>

<p>View your full order details in your dashboard: <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/orders" style="color: #3b82f6; text-decoration: none;">View Orders</a></p>

<p>Best Regards,<br>The ProxySock Team</p>
