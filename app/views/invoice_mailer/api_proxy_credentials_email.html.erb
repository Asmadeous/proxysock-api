<h1 style="font-size: 24px; margin-bottom: 24px; color: #000000;">API Proxy Access</h1>

<p style="margin-bottom: 24px;">Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p style="margin-bottom: 32px;">Your <strong><%= @order.product.name %></strong> for order <strong>#<%= @order.order_number %></strong> is now active and ready for use.</p>

<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 12px; padding: 32px; margin-bottom: 32px;">
    <h3 style="margin-bottom: 20px; font-size: 18px;">Access Credentials</h3>
    
    <% if @api_response['ips'].is_a?(Array) %>
      <%# New Static IP format %>
      <% @api_response['ips'].each_with_index do |cred, idx| %>
        <div style="margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px dashed #E5E7EB;">
          <p style="margin-bottom: 8px; font-weight: 600;">Proxy #<%= idx + 1 %> 
            <span style="font-weight: normal; color: #6B7280; font-size: 13px;">
              (<%= @api_response.dig('ips_info', idx) %>)
            </span>
          </p>
          <code style="display: block; background: #F3F4F6; padding: 12px; border-radius: 6px; font-family: monospace; font-size: 14px; overflow-x: auto;">
            <%= cred %>
          </code>
        </div>
      <% end %>

    <% elsif @api_response['vpn_info'].is_a?(Array) %>
      <%# VPN format %>
      <% vpn = @api_response['vpn_info'].first %>
      <% creds = @api_response.dig('config', 'auth_credentials') || {} %>
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
        <tr>
            <td style="padding: 8px 0;">VPN Name</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= vpn['vpn_name'] %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">IP info</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= vpn['ip_info'] %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">VPN Type</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= vpn['vpn_type'] %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Username</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600; font-family: monospace;"><%= creds['username'] %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Password</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600; font-family: monospace;"><%= creds['password'] %></td>
        </tr>
      </table>

    <% else %>
      <%# Original single proxy format %>
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
          <% if @api_response['ip'].present? %>
          <tr>
              <td style="padding: 8px 0;">IP Address</td>
              <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600; font-family: monospace;"><%= @api_response['ip'] %></td>
          </tr>
          <% end %>
          <% port = @api_response['port'] || @api_response['http_port'] || @api_response['socks5_port'] %>
          <% if port.present? %>
          <tr>
              <td style="padding: 8px 0;">Port</td>
              <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600; font-family: monospace;"><%= port %></td>
          </tr>
          <% end %>
          <% if @api_response['username'].present? %>
          <tr>
              <td style="padding: 8px 0;">Username</td>
              <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600; font-family: monospace;"><%= @api_response['username'] %></td>
          </tr>
          <% end %>
          <% if @api_response['password'].present? %>
          <tr>
              <td style="padding: 8px 0;">Password</td>
              <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600; font-family: monospace;"><%= @api_response['password'] %></td>
          </tr>
          <% end %>
          <% if @api_response['country'].present? || @api_response['location'].present? %>
          <tr>
              <td style="padding: 8px 0;">Location</td>
              <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600;"><%= @api_response['country'] || @api_response['location'] %></td>
          </tr>
          <% end %>
      </table>
    <% end %>
    
    <% if @api_response['expires_at'].present? || @api_response['expiry'].present? %>
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563; margin-top: 8px; border-top: 1px solid #E5E7EB;">
      <tr>
          <td style="padding: 8px 0;">Expires</td>
          <td style="padding: 8px 0; text-align: right; color: #EF4444; font-weight: 600;"><%= @api_response['expires_at'] || @api_response['expiry'] %></td>
      </tr>
    </table>
    <% end %>
</div>

<% if @api_response['ips'].is_a?(Array) || @api_response['ip'].present? %>
    <div style="background-color: #E7F3FF; padding: 20px; border-radius: 8px; margin-bottom: 32px; border: 1px solid #BEE3F8;">
        <h4 style="margin: 0 0 12px 0; color: #2B6CB0; font-size: 16px;">Proxy Activation Instructions:</h4>
        <ol style="margin: 0; padding-left: 20px; color: #2D3748; font-size: 14px; line-height: 1.6;">
            <li>Configure your browser or software using the <strong>IP:Port:User:Pass</strong> format provided above.</li>
            <li>For <strong>SOCKS5</strong> or <strong>HTTP/S</strong>, ensure your software supports the selected protocol.</li>
            <li>If you experience connection issues, ensure your <strong>Whitelist IP</strong> is correctly set in the dashboard.</li>
        </ol>
    </div>
<% elsif @api_response['vpn_info'].is_a?(Array) %>
    <div style="background-color: #E7F3FF; padding: 20px; border-radius: 8px; margin-bottom: 32px; border: 1px solid #BEE3F8;">
        <h4 style="margin: 0 0 12px 0; color: #2B6CB0; font-size: 16px;">VPN Activation Instructions:</h4>
        <ol style="margin: 0; padding-left: 20px; color: #2D3748; font-size: 14px; line-height: 1.6;">
            <li>Download the <strong>.ovpn</strong> configuration file from your dashboard if provided.</li>
            <li>Import the file into your VPN client (e.g., <strong>OpenVPN</strong> or <strong>Tunnelblick</strong>).</li>
            <li>Use the <strong>Username</strong> and <strong>Password</strong> listed above to connect.</li>
        </ol>
    </div>
<% elsif @order.product.name.downcase.include?('esim') || @order.product.name.downcase.include?('global-isp') %>
    <div style="background-color: #E7F3FF; padding: 20px; border-radius: 8px; margin-bottom: 32px; border: 1px solid #BEE3F8;">
        <h4 style="margin: 0 0 12px 0; color: #2B6CB0; font-size: 16px;">eSIM Activation Instructions:</h4>
        <ol style="margin: 0; padding-left: 20px; color: #2D3748; font-size: 14px; line-height: 1.6;">
            <li>Go to <strong>Settings</strong> > <strong>Cellular/Mobile Data</strong> on your device.</li>
            <li>Select <strong>Add eSIM</strong> and scan the QR code provided in your dashboard.</li>
            <li>Ensure <strong>Data Roaming</strong> is turned <strong>ON</strong> for the eSIM line.</li>
            <li>Restart your device if the signal does not appear within 5 minutes.</li>
        </ol>
    </div>
<% end %>

<div style="text-align: center; margin: 40px 0;">
    <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/orders" class="btn">View Orders</a>
</div>
