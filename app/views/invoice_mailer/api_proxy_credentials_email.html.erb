<h1 style="font-size: 24px; margin-bottom: 24px; color: #000000;">Proxy Credentials</h1>

<p style="margin-bottom: 24px;">Dear <%= @owner.try(:username) || @owner.try(:email) %>,</p>

<p style="margin-bottom: 32px;">Your <strong><%= @order.product.name %></strong> credentials are ready:</p>

<%= render partial: 'mailers/jellyfin_section' %>

<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 12px; padding: 32px; margin-bottom: 32px;">
    <% 
       ips_list = if @api_response['ips'].is_a?(Hash)
                    @api_response.dig('ips', 'http') || @api_response.dig('ips', 'socks5')
                  else
                    @api_response['ips']
                  end
    %>
    <% if ips_list.is_a?(Array) %>
      <% ips_list.each_with_index do |cred_string, idx| %>
        <% parts = cred_string.split(':', -1) %>
        <% creds_undefined = parts.length >= 4 && (parts[2] == 'undefined' || parts[3] == 'undefined') %>
        <div style="margin-bottom: 24px; <%= 'border-top: 1px solid #E5E7EB; padding-top: 24px;' if idx > 0 %>">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
                <tr>
                    <td style="padding: 8px 0; font-weight: 600; color: #000000;">IP Address</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-family: monospace;"><%= parts[0] %></td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; font-weight: 600; color: #000000;">Port</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-family: monospace;"><%= parts[1] %></td>
                </tr>
                <% unless creds_undefined %>
                <tr>
                    <td style="padding: 8px 0; font-weight: 600; color: #000000;">Username</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-family: monospace;"><%= parts[2] %></td>
                </tr>
                <tr>
                    <td style="padding: 8px 0; font-weight: 600; color: #000000;">Password</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000; font-family: monospace;"><%= parts[3] %></td>
                </tr>
                <% end %>
                <tr>
                    <td style="padding: 8px 0; font-weight: 600; color: #000000;">Protocol</td>
                    <td style="padding: 8px 0; text-align: right; color: #000000;"><%= @api_response.dig('config', 'proxy_format') || 'http' %></td>
                </tr>
                <% if creds_undefined %>
                <tr>
                    <td colspan="2" style="padding: 12px 0;">
                        <div style="background-color: #FEF3C7; border: 1px solid #F59E0B; border-radius: 8px; padding: 12px 16px;">
                            <p style="margin: 0 0 4px 0; font-weight: 600; color: #92400E; font-size: 13px;">🔒 IP Whitelisted</p>
                            <p style="margin: 0; color: #92400E; font-size: 12px;">This proxy is authenticated via IP whitelisting — no username or password is required. If you need to whitelist a different IP address, please contact our support team.</p>
                        </div>
                    </td>
                </tr>
                <% end %>
            </table>
        </div>
      <% end %>

    <% elsif @api_response['vpn_info'].is_a?(Array) %>
      <%# Maintain VPN format as it was not included in the "Nothing More" request for static types %>
      <% vpn = @api_response['vpn_info'].first %>
      <% creds = @api_response.dig('config', 'auth_credentials') || {} %>
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
        <tr>
            <td style="padding: 8px 0;">Username</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600; font-family: monospace;"><%= creds['username'] %></td>
        </tr>
        <tr>
            <td style="padding: 8px 0;">Password</td>
            <td style="padding: 8px 0; text-align: right; color: #000000; font-weight: 600; font-family: monospace;"><%= creds['password'] %></td>
        </tr>
      </table>
    <% else %>
      <%# Fallback single format %>
      <% creds_undefined = @api_response['username'] == 'undefined' || @api_response['password'] == 'undefined' %>
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; color: #4B5563;">
          <tr>
              <td style="padding: 8px 0; font-weight: 600; color: #000000;">IP Address</td>
              <td style="padding: 8px 0; text-align: right; color: #000000; font-family: monospace;"><%= @api_response['ip'] %></td>
          </tr>
          <tr>
              <td style="padding: 8px 0; font-weight: 600; color: #000000;">Port</td>
              <td style="padding: 8px 0; text-align: right; color: #000000; font-family: monospace;"><%= @api_response['port'] || @api_response['http_port'] %></td>
          </tr>
          <% unless creds_undefined %>
          <tr>
              <td style="padding: 8px 0; font-weight: 600; color: #000000;">Username</td>
              <td style="padding: 8px 0; text-align: right; color: #000000; font-family: monospace;"><%= @api_response['username'] %></td>
          </tr>
          <tr>
              <td style="padding: 8px 0; font-weight: 600; color: #000000;">Password</td>
              <td style="padding: 8px 0; text-align: right; color: #000000; font-family: monospace;"><%= @api_response['password'] %></td>
          </tr>
          <% end %>
          <tr>
              <td style="padding: 8px 0; font-weight: 600; color: #000000;">Protocol</td>
              <td style="padding: 8px 0; text-align: right; color: #000000;"><%= @api_response.dig('config', 'proxy_format') || 'http' %></td>
          </tr>
          <% if creds_undefined %>
          <tr>
              <td colspan="2" style="padding: 12px 0;">
                  <div style="background-color: #FEF3C7; border: 1px solid #F59E0B; border-radius: 8px; padding: 12px 16px;">
                      <p style="margin: 0 0 4px 0; font-weight: 600; color: #92400E; font-size: 13px;">🔒 IP Whitelisted</p>
                      <p style="margin: 0; color: #92400E; font-size: 12px;">This proxy is authenticated via IP whitelisting — no username or password is required. If you need to whitelist a different IP address, please contact our support team.</p>
                  </div>
              </td>
          </tr>
          <% end %>
      </table>
    <% end %>
</div>

<div style="text-align: center; margin: 40px 0;">
    <a href="<%= ENV['FRONTEND_URL'] %>/dashboard/orders" class="btn">View Orders</a>
</div>
