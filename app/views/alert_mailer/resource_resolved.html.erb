<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 0; background-color: #0f0f0f; color: #e0e0e0; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: linear-gradient(135deg, #16a34a, #15803d); border-radius: 12px 12px 0 0; padding: 24px; text-align: center; }
    .header h1 { color: #fff; font-size: 20px; margin: 0; }
    .header .icon { font-size: 40px; margin-bottom: 8px; }
    .body { background-color: #1a1a1a; border: 1px solid #333; border-top: none; border-radius: 0 0 12px 12px; padding: 24px; }
    .metric-card { background-color: #222; border: 1px solid #444; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
    .metric-label { font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
    .metric-value { font-size: 28px; font-weight: 700; color: #22c55e; }
    .metric-threshold { font-size: 13px; color: #888; margin-top: 4px; }
    .detail-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #333; font-size: 14px; }
    .detail-label { color: #888; }
    .detail-value { color: #e0e0e0; font-weight: 500; }
    .footer { text-align: center; padding: 16px; font-size: 12px; color: #666; }
    .badge { display: inline-block; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 600; }
    .badge-resolved { background-color: rgba(34, 197, 94, 0.2); color: #22c55e; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="icon">🟢</div>
      <h1>Resolved — <%= @resource_label %></h1>
    </div>
    <div class="body">
      <div class="metric-card">
        <div class="metric-label"><%= @metric_label %> Usage</div>
        <div class="metric-value"><%= @value %>%</div>
        <div class="metric-threshold">Threshold: <%= @threshold %>% (no longer exceeded)</div>
      </div>

      <div class="detail-row">
        <span class="detail-label">Resource</span>
        <span class="detail-value"><%= @resource_name %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Type</span>
        <span class="detail-value"><%= @resource_label %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Metric</span>
        <span class="detail-value"><%= @metric_label %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Status</span>
        <span class="detail-value"><span class="badge badge-resolved">RESOLVED</span></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Resolved At</span>
        <span class="detail-value"><%= @timestamp.strftime('%Y-%m-%d %H:%M:%S %Z') %></span>
      </div>

      <p style="margin-top: 20px; font-size: 13px; color: #888; line-height: 1.5;">
        <strong><%= @metric_label %></strong> usage on <strong><%= @resource_name %></strong>
        has dropped to <strong><%= @value %>%</strong>, which is below the <%= @threshold %>% threshold.
        This alert is now resolved.
      </p>
    </div>
    <div class="footer">
      <p>ProxySock Infrastructure Monitoring</p>
      <p>This is an automated alert. Do not reply to this email.</p>
    </div>
  </div>
</body>
</html>
