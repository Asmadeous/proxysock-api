# Development Procfile - Start both Rails and Vite frontend
# Usage: bin/dev or foreman start -f Procfile.dev
#
# Rails: http://localhost:3000 (API backend)
# Vite: http://localhost:3001 (Frontend)

rails: PORT=3000 bin/rails server
vite: cd client && npm run dev -- --port 3001
sidekiq: bundle exec sidekiq -C config/sidekiq.yml

